{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VideoFactory Static Jump-Cut Style Plan",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_name", "source", "mode", "normal_scale", "punch_in_scale", "anchor", "segments"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "project_name": {"type": "string", "minLength": 1},
    "source": {"type": "string", "const": "retimed_edit_timeline.json"},
    "mode": {"type": "string", "const": "alternate_static_punch_in"},
    "normal_scale": {"type": "number", "const": 1.0},
    "punch_in_scale": {"type": "number", "exclusiveMinimum": 1.0, "maximum": 1.20},
    "anchor": {"type": "string", "const": "center"},
    "segments": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["segment_index", "edited_start", "edited_end", "scale"],
      "properties": {
        "segment_index": {"type": "integer", "minimum": 1},
        "edited_start": {"type": "number", "minimum": 0},
        "edited_end": {"type": "number", "exclusiveMinimum": 0},
        "scale": {"type": "number", "minimum": 1.0, "maximum": 1.20}
      }}}
  }
}
