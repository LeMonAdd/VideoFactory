{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VideoFactory Canonical Retime Map",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_name", "source_duration", "edited_duration", "segments"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "project_name": {"type": "string", "minLength": 1},
    "source_duration": {"type": "number", "exclusiveMinimum": 0},
    "edited_duration": {"type": "number", "exclusiveMinimum": 0},
    "segments": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false,
      "required": ["source_start", "source_end", "source_duration", "edited_start", "edited_end"],
      "properties": {
        "source_start": {"type": "number", "minimum": 0},
        "source_end": {"type": "number", "exclusiveMinimum": 0},
        "source_duration": {"type": "number", "exclusiveMinimum": 0},
        "edited_start": {"type": "number", "minimum": 0},
        "edited_end": {"type": "number", "exclusiveMinimum": 0}
      }}}
  }
}
