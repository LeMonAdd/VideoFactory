{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VideoFactory Speech Render Manifest",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_name", "input_edit_timeline", "input_speech_edit_plan", "input_retime_map", "input_retimed_edit_timeline", "output_path", "encoder", "source_duration", "edited_duration", "total_removed_duration", "keep_segment_count", "original_broll_overlay_count", "retimed_broll_overlay_segment_count", "width", "height", "fps", "duration", "video_codec", "audio_codec", "video_streams", "audio_streams", "metadata_stripped", "file_size_bytes", "sha256", "speech_edit_plan_sha256", "retime_map_sha256", "retimed_edit_timeline_sha256"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "project_name": {"type": "string", "minLength": 1},
    "input_edit_timeline": {"type": "string", "const": "edit_timeline.json"},
    "input_speech_edit_plan": {"type": "string", "const": "speech_edit_plan.json"},
    "input_retime_map": {"type": "string", "const": "retime_map.json"},
    "input_retimed_edit_timeline": {"type": "string", "const": "retimed_edit_timeline.json"},
    "output_path": {"type": "string", "minLength": 1},
    "encoder": {"type": "string", "enum": ["libx264", "h264_videotoolbox"]},
    "source_duration": {"type": "number", "exclusiveMinimum": 0},
    "edited_duration": {"type": "number", "exclusiveMinimum": 0},
    "total_removed_duration": {"type": "number", "minimum": 0},
    "keep_segment_count": {"type": "integer", "minimum": 1},
    "original_broll_overlay_count": {"type": "integer", "minimum": 0},
    "retimed_broll_overlay_segment_count": {"type": "integer", "minimum": 0},
    "width": {"type": "integer", "const": 1920},
    "height": {"type": "integer", "const": 1080},
    "fps": {"type": "number", "minimum": 29.9, "maximum": 30.1},
    "duration": {"type": "number", "exclusiveMinimum": 0},
    "video_codec": {"type": "string", "const": "h264"},
    "audio_codec": {"type": "string", "const": "aac"},
    "video_streams": {"type": "integer", "const": 1},
    "audio_streams": {"type": "integer", "const": 1},
    "metadata_stripped": {"type": "boolean", "const": true},
    "file_size_bytes": {"type": "integer", "minimum": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "speech_edit_plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "retime_map_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "retimed_edit_timeline_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
