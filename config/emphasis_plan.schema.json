{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_name", "provider", "duration", "source_candidates", "max_count", "min_gap_seconds", "input_sha256", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "project_name": {"type": "string", "minLength": 1},
    "provider": {"enum": ["rule", "codex"]},
    "duration": {"type": "number", "exclusiveMinimum": 0},
    "source_candidates": {"const": "emphasis_candidates.json"},
    "max_count": {"type": "integer", "minimum": 1},
    "min_gap_seconds": {"type": "number", "minimum": 0},
    "input_sha256": {"type": "object", "additionalProperties": false,
      "required": ["transcript.json", "retime_map.json", "caption_timeline.json", "retimed_edit_timeline.json", "emphasis_candidates.json"],
      "properties": {
        "transcript.json": {"$ref": "#/$defs/hash"},
        "retime_map.json": {"$ref": "#/$defs/hash"},
        "caption_timeline.json": {"$ref": "#/$defs/hash"},
        "retimed_edit_timeline.json": {"$ref": "#/$defs/hash"},
        "emphasis_candidates.json": {"$ref": "#/$defs/hash"}
      }},
    "items": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["index", "candidate_id", "text", "speech_start", "speech_end", "timeline_start", "timeline_end"],
      "properties": {
        "index": {"type": "integer", "minimum": 1},
        "candidate_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "speech_start": {"type": "number", "minimum": 0},
        "speech_end": {"type": "number", "exclusiveMinimum": 0},
        "timeline_start": {"type": "number", "minimum": 0},
        "timeline_end": {"type": "number", "exclusiveMinimum": 0}
      }}}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
