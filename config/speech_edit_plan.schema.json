{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VideoFactory Speech Edit Plan",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "project_name", "source_duration", "pause_threshold_seconds", "pause_keep_seconds", "speech_boundary_padding_seconds", "detection", "cuts", "keep_segments", "total_removed_duration", "edited_duration"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "project_name": {"type": "string", "minLength": 1},
    "source_duration": {"type": "number", "exclusiveMinimum": 0},
    "pause_threshold_seconds": {"type": "number", "exclusiveMinimum": 0},
    "pause_keep_seconds": {"type": "number", "minimum": 0},
    "speech_boundary_padding_seconds": {"type": "number", "minimum": 0},
    "detection": {"type": "object", "additionalProperties": false,
      "required": ["method", "noise_db"],
      "properties": {
        "method": {"type": "string", "const": "ffmpeg_silencedetect"},
        "noise_db": {"type": "number", "exclusiveMinimum": -100, "exclusiveMaximum": 0}
      }},
    "cuts": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "source_start", "source_end", "removed_duration", "detected_silence_start", "detected_silence_end", "reason", "affected_overlay_shot_ids"],
      "properties": {
        "id": {"type": "integer", "minimum": 1},
        "source_start": {"type": "number", "minimum": 0},
        "source_end": {"type": "number", "exclusiveMinimum": 0},
        "removed_duration": {"type": "number", "exclusiveMinimum": 0},
        "detected_silence_start": {"type": "number", "minimum": 0},
        "detected_silence_end": {"type": "number", "exclusiveMinimum": 0},
        "reason": {"type": "string", "const": "Long detected audio silence"},
        "affected_overlay_shot_ids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
      }}},
    "keep_segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/keep"}},
    "total_removed_duration": {"type": "number", "minimum": 0},
    "edited_duration": {"type": "number", "exclusiveMinimum": 0}
  },
  "$defs": {"keep": {"type": "object", "additionalProperties": false,
    "required": ["source_start", "source_end", "source_duration", "edited_start", "edited_end"],
    "properties": {
      "source_start": {"type": "number", "minimum": 0},
      "source_end": {"type": "number", "exclusiveMinimum": 0},
      "source_duration": {"type": "number", "exclusiveMinimum": 0},
      "edited_start": {"type": "number", "minimum": 0},
      "edited_end": {"type": "number", "exclusiveMinimum": 0}
    }}}
}
